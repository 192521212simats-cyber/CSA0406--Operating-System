#include<stdio.h>

int main()
{
    int p[5]={3,1,2,5,4};
    int i,j,t;

    for(i=0;i<5;i++)
        for(j=i+1;j<5;j++)
            if(p[i]>p[j])
            {
                t=p[i];
                p[i]=p[j];
                p[j]=t;
            }

    printf("Execution Order:\n");
    for(i=0;i<5;i++)
        printf("%d ",p[i]);

    return 0;
}
