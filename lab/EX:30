#include <stdio.h>
#include <pthread.h>

void *display(void *arg)
{
    printf("Thread created successfully.\n");
    return NULL;
}

int main()
{
    pthread_t thread;

    pthread_create(&thread, NULL, display, NULL);

    pthread_join(thread, NULL);

    return 0;
}
