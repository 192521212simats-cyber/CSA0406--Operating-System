#include <stdio.h>

int main()
{
    int block[50], next[50];
    int n, i, first, last;

    printf("Enter number of blocks in the file: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    // Create linked list
    for(i = 0; i < n - 1; i++)
        next[i] = i + 1;

    next[n - 1] = -1;

    first = 0;
    last = n - 1;

    printf("\nLinked File Allocation:\n");
    printf("First Block = %d\n", block[first]);
    printf("Last Block  = %d\n", block[last]);

    printf("\nFile blocks:\n");

    i = first;

    while(i != -1)
    {
        printf("Block %d -> ", block[i]);
        i = next[i];
    }

    printf("NULL\n");

    return 0;
}
